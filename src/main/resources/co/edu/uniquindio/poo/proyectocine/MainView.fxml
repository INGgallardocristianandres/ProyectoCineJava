<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectocine.controller.MainController" styleClass="app-shell" stylesheets="@cinema.css" prefWidth="1280" prefHeight="850">
    <left><VBox fx:id="menuLateral" prefWidth="236" minWidth="236" spacing="6" styleClass="sidebar">
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="brand"><Label text="C" styleClass="brand-mark"/><VBox spacing="2"><Label text="CinemaUQ" styleClass="brand-name"/><Label fx:id="lblUsuarioActivo" text="Sin sesión" styleClass="brand-caption"/></VBox></HBox>
        <Label text="NAVEGACIÓN" styleClass="nav-caption"/>
        <Button text="Iniciar sesión / Registro" onAction="#abrirLogin" userData="Login" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Comprar entradas" onAction="#abrirCompras" userData="Compra" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Mi cuenta y cancelaciones" onAction="#abrirClientes" userData="Cliente" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Mis puntos (Redimir)" onAction="#abrirPuntos" userData="Puntos" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Películas" onAction="#abrirPeliculas" userData="Pelicula" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Salas" onAction="#abrirSalas" userData="Sala" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Funciones" onAction="#abrirFunciones" userData="Funcion" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Confitería y Combos" onAction="#abrirConfiteria" userData="Confiteria" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Recargar tarjetas" onAction="#abrirTarjetas" userData="TarjetaVirtual" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Reportes" onAction="#abrirReportes" userData="Reporte" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Cerrar sesión" onAction="#salirSesion" userData="Salir" maxWidth="Infinity" styleClass="nav-button"/>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox spacing="7" styleClass="sidebar-footer"><Label text="Luces, cámara, acción." styleClass="footer-title" wrapText="true"/><Label text="Todo para una gran función." styleClass="footer-caption" wrapText="true"/></VBox>
    </VBox></left>
    <center><StackPane fx:id="contenido"/></center>
</BorderPane>