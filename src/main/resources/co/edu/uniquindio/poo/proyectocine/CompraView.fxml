<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectocine.viewController.CompraViewController" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" stylesheets="@cinema.css"><content><VBox spacing="22" styleClass="page"><Label text="Compras" styleClass="page-title" wrapText="true"/><VBox spacing="18" styleClass="card"><VBox spacing="5"><Label text="Cliente y función" styleClass="card-title" wrapText="true"/><Label text="Elige para quién es la compra y qué película disfrutará." styleClass="muted" wrapText="true"/></VBox><GridPane hgap="18"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><children><VBox GridPane.columnIndex="0"><VBox spacing="7"><Label text="Cliente" styleClass="field-label" wrapText="true"/><ComboBox fx:id="cbCliente" promptText="Selecciona un cliente" maxWidth="Infinity" onAction="#actualizarPuntos"/></VBox></VBox><VBox GridPane.columnIndex="1"><VBox spacing="7"><Label text="Función" styleClass="field-label" wrapText="true"/><ComboBox fx:id="cbFuncion" promptText="Selecciona una función" maxWidth="Infinity" onAction="#cargarAsientos"/></VBox></VBox></children></GridPane></VBox><VBox spacing="18" styleClass="card"><VBox spacing="5"><Label text="Elige los asientos" styleClass="card-title" wrapText="true"/><Label text="Usa Ctrl o Shift para seleccionar varios. Los asientos ocupados no pueden comprarse." styleClass="muted" wrapText="true"/></VBox><ListView fx:id="lvAsientos" prefHeight="230" minHeight="150"><placeholder><Label text="Selecciona una función para ver sus asientos." styleClass="empty-label" wrapText="true"/></placeholder></ListView></VBox><VBox spacing="18" styleClass="card"><VBox spacing="5"><Label text="Algo para acompañar" styleClass="card-title" wrapText="true"/><Label text="Puedes agregar el mismo producto varias veces." styleClass="muted" wrapText="true"/></VBox><VBox spacing="7"><Label text="Producto" styleClass="field-label" wrapText="true"/><ComboBox fx:id="cbProducto" promptText="Selecciona un producto" maxWidth="Infinity"/></VBox><HBox spacing="10"><Button text="Agregar a la compra" onAction="#agregarProducto" styleClass="secondary-button"/><Button text="Quitar seleccionado" onAction="#quitarProducto" styleClass="secondary-button"/></HBox><ListView fx:id="lvCarrito" prefHeight="170" minHeight="150"><placeholder><Label text="Tu compra aún no tiene productos." styleClass="empty-label" wrapText="true"/></placeholder></ListView></VBox><HBox spacing="20" alignment="CENTER_LEFT" styleClass="checkout-bar"><VBox spacing="4"><Label text="RESUMEN DE COMPRA" styleClass="eyebrow" wrapText="true"/><Label fx:id="lblTotal" text="Total: 0.00" styleClass="total-label"/><Label fx:id="lblPuntos" text="Selecciona un cliente para ver sus puntos" wrapText="true" styleClass="muted"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Pagar con tarjeta virtual" onAction="#comprar" styleClass="primary-button"/></HBox></VBox></content></ScrollPane>
