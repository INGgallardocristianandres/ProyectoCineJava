<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectocine.viewController.ConfiteriaViewController" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" stylesheets="@cinema.css"><content><VBox spacing="22" styleClass="page">
    <Label text="Confitería y Combos" styleClass="page-title" wrapText="true"/>
    <VBox spacing="18" styleClass="card">
        <VBox spacing="5"><Label text="Agregar producto individual" styleClass="card-title"/><Label text="Producto base de confitería." styleClass="muted"/></VBox>
        <GridPane hgap="18"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><children>
            <VBox GridPane.columnIndex="0" spacing="7"><Label text="Nombre del producto" styleClass="field-label"/><TextField fx:id="txtNombre" promptText="Ej. Perro caliente"/></VBox>
            <VBox GridPane.columnIndex="1" spacing="7"><Label text="Precio" styleClass="field-label"/><TextField fx:id="txtPrecio" promptText="Valor sin separadores de miles"/></VBox>
        </children></GridPane>
        <Button text="Registrar producto" onAction="#registrar" styleClass="primary-button"/>
    </VBox>
    <VBox spacing="18" styleClass="card">
        <VBox spacing="5"><Label text="Armar Combo (Patrón Builder + Composite)" styleClass="card-title"/><Label text="Selecciona varios productos con Ctrl/Shift y define el porcentaje de descuento." styleClass="muted" wrapText="true"/></VBox>
        <GridPane hgap="18"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><children>
            <VBox GridPane.columnIndex="0" spacing="7"><Label text="Nombre del combo" styleClass="field-label"/><TextField fx:id="txtNombreCombo" promptText="Ej. Combo Familiar"/></VBox>
            <VBox GridPane.columnIndex="1" spacing="7"><Label text="Descuento (%)" styleClass="field-label"/><TextField fx:id="txtDescuentoCombo" promptText="Ej. 15"/></VBox>
        </children></GridPane>
        <ListView fx:id="lvSeleccionCombo" prefHeight="150"/>
        <Button text="Construir combo" onAction="#crearCombo" styleClass="primary-button"/>
    </VBox>
    <VBox spacing="18" styleClass="card">
        <VBox spacing="5"><Label text="Catálogo disponible" styleClass="card-title"/></VBox>
        <ListView fx:id="lvProductos" prefHeight="190"/>
    </VBox>
</VBox></content></ScrollPane>