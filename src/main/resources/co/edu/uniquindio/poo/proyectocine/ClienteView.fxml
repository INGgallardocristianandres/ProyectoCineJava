<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.proyectocine.viewController.ClienteViewController"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="page-scroll" stylesheets="@cinema.css">
    <content>
        <VBox spacing="22" styleClass="page">
            <Label text="Mi Cuenta y Cancelaciones" styleClass="page-title" wrapText="true"/>

            <VBox spacing="18" styleClass="card">
                <VBox spacing="5">
                    <Label text="Solicitar cancelación de compra" styleClass="card-title"/>
                    <Label text="Política: más de 24h devuelve 100% | Entre 2h y 24h devuelve 80% | menos de 2h no permite cancelación." styleClass="muted" wrapText="true"/>
                </VBox>
                <ComboBox fx:id="cbComprasCancelables" promptText="Selecciona una compra activa para cancelar" maxWidth="Infinity"/>
                <Button text="Cancelar compra y solicitar reembolso" onAction="#cancelarCompra" styleClass="primary-button"/>
            </VBox>

            <VBox spacing="18" styleClass="card">
                <VBox spacing="5">
                    <Label text="Saldo, movimientos e historial" styleClass="card-title"/>
                    <Label text="Detalle actualizado de tu tarjeta virtual, puntos y compras." styleClass="muted"/>
                </VBox>
                <TextArea fx:id="taCuenta" editable="false" wrapText="true" prefHeight="300" styleClass="detail-area"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>